<!-- Cabeçalho -->
<div class="row align-items-center mb-4">
  <div class="col-12 col-md-6 d-flex align-items-center mb-3 mb-md-0">
    <img src="/images/logo.png" alt="logo" class="img-fluid me-2" width="48" />
    <h1 class="h5 mb-0">Lista de Tarefas</h1>
  </div>
  <div class="col-12 col-md-6 text-md-end">
    <div class="d-flex flex-column flex-sm-row justify-content-md-end gap-2">
      <a href="/tarefas/adicionar" class="btn btn-primary d-flex align-items-center justify-content-center">
        <i class="bi bi-plus me-1"></i> Nova tarefa
      </a>
    </div>
  </div>
  <hr class="mt-4" />
</div>

<!-- Modal de Confirmação -->
<div class="modal fade" id="modalConfirmacao" tabindex="-1" aria-labelledby="modalConfirmacaoLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalConfirmacaoLabel">Confirmar exclusão</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        Tem certeza que deseja excluir esta tarefa?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="btnConfirmarExclusao">Excluir</button>
      </div>
    </div>
  </div>
</div>

<!-- Mensagem de status -->
<div id="mensagem-status" style="display: none;" class="alert alert-success"></div>

<!-- Lista de Tarefas -->
{{#if tarefas.length}}
  {{#each tarefas}}
    <div class="row mb-3" id="tarefa-{{id}}">
      <div class="col-12 border border-secondary rounded p-3 shadow-sm">
        <div class="row align-items-center gy-3">
          <div class="col-12 col-md-7 d-flex align-items-center">
            <i class="bi bi-arrow-right-circle-fill text-info fs-5 me-2"></i>
            <h6 class="mb-0">{{descricao}}</h6>
          </div>
          <div class="col-12 col-md-3">
            <span class="badge bg-secondary">{{status.nome}}</span>
          </div>
          <div class="col-12 col-md-2 d-flex justify-content-md-end justify-content-start gap-2">
            <a href="/tarefas/editar/{{id}}" class="btn btn-outline-primary btn-sm">
              <i class="bi bi-pencil-square"></i> Editar
            </a>
            <button class="btn btn-outline-danger btn-sm" onclick="abrirModalConfirmacao({{id}})">
              <i class="bi bi-trash3"></i> Deletar
            </button>
          </div>
        </div>
      </div>
    </div>
  {{/each}}
{{else}}
  <!-- Sem tarefas -->
  <div class="row" id="no_tasks">
    <div class="col text-center">
      <span class="opacity-75">Não existem tarefas para apresentar</span>
    </div>
  </div>
{{/if}}

<!-- Total de tarefas -->
<div class="row">
  <div class="col">
    <p>Tarefas: <span class="text-info">{{tarefas.length}}</span></p>
  </div>
</div>

<!-- Rodapé -->
<div class="row mt-3">
  <div class="col text-center">
    <hr />
    <p>Lista de Tarefas &copy; 2025</p>
  </div>
</div>

<!-- Scripts -->
<script>
  let idTarefaParaExcluir = null;

  function abrirModalConfirmacao(id) {
    idTarefaParaExcluir = id;
    const modal = new bootstrap.Modal(document.getElementById('modalConfirmacao'));
    modal.show();
  }

  document.getElementById('btnConfirmarExclusao').addEventListener('click', () => {
    if (!idTarefaParaExcluir) return;

    fetch(`/tarefas/deletar/${idTarefaParaExcluir}`, {
      method: 'DELETE'
    })
    .then(res => res.json())
    .then(data => {
      const msgDiv = document.getElementById("mensagem-status");

      if (data.mensagem) {
        msgDiv.textContent = data.mensagem;
        msgDiv.className = "alert alert-success";

        // Fecha o modal
        const modalEl = document.getElementById('modalConfirmacao');
        bootstrap.Modal.getInstance(modalEl).hide();
        idTarefaParaExcluir = null;

        // Mostra mensagem de sucesso e recarrega a página após um tempo
        msgDiv.style.display = "block";

        setTimeout(() => {
          location.reload(); // Recarrega a página para atualizar a contagem
        }, 1000);

      } else {
        msgDiv.textContent = data.erro || "Erro ao excluir.";
        msgDiv.className = "alert alert-danger";
        msgDiv.style.display = "block";
      }

    })
    .catch(err => {
      const msgDiv = document.getElementById("mensagem-status");
      msgDiv.textContent = "Erro ao excluir tarefa.";
      msgDiv.className = "alert alert-danger";
      msgDiv.style.display = "block";
    });
  });
</script>