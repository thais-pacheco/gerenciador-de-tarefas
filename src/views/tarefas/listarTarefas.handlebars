<div class="d-flex justify-content-between align-items-center mt-4">
  <div class="d-flex align-items-center gap-2">
    <img src="/images/logo.png" alt="Logo" style="height: 40px;">
    <h2 class="fw-bold text-primary mb-0">Minhas Tarefas</h2>
  </div>
  <div class="d-flex gap-2">
    <a href="/tarefas/adicionar" class="btn btn-primary">
      <i class="bi bi-plus-circle"></i> Nova Tarefa
    </a>
    <form action="/logout" method="POST">
      <button class="btn btn-outline-danger">
        Sair <i class="bi bi-box-arrow-right"></i>
      </button>
    </form>
  </div>
</div>

<hr class="text-primary">

<form method="get" class="row g-3 mb-4">
  <div class="col-md-4">
    <select name="status" class="form-select">
      <option value="">-- Filtrar por status --</option>
      {{#each statusList}}
      <option value="{{this.id}}" {{#if (eq this.id ../statusFiltrado)}}selected{{/if}}>
        {{this.nome}}
      </option>
      {{/each}}
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-primary">
      <i class="bi bi-filter"></i> Filtrar
    </button>
  </div>
  <div class="col-auto">
    <a href="/tarefas" class="btn btn-secondary">
      <i class="bi bi-x-circle"></i> Limpar Filtro
    </a>
  </div>
</form>

<div id="mensagem-status" style="display: none;" class="alert"></div>

<p class="text-muted">Total de tarefas: <strong>{{total}}</strong></p>

{{#if tarefas.length}}
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  {{#each tarefas}}
  <div class="col" id="tarefa-{{id}}">
    <div class="card h-100 border- border-{{#if (eq this.status_id 1)}}success{{else if (eq this.status_id 2)}}warning{{else}}secondary{{/if}} shadow-sm">
      <div class="card-body">
        <h5 class="card-title">{{nome}}</h5>
        <p class="card-text text-muted">{{descricao}}</p>
        <span class="badge bg-{{#if (eq this.status_id 1)}}success{{else if (eq this.status_id 2)}}warning{{else}}secondary{{/if}}">
          {{status.nome}}
        </span>
      </div>
      <div class="card-footer d-flex justify-content-between bg-light">
        <a href="/tarefas/editar/{{id}}" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-pencil"></i> Editar
        </a>
        <button class="btn btn-sm btn-outline-danger" onclick="abrirModalConfirmacao({{id}})">
          <i class="bi bi-trash"></i> Excluir
        </button>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{else}}
<p class="text-center text-muted mt-5">Nenhuma tarefa encontrada com o filtro selecionado.</p>
{{/if}}

<div class="modal fade" id="modalConfirmacao" tabindex="-1" aria-labelledby="modalConfirmacaoLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalConfirmacaoLabel">Confirmar Exclusão</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        Tem certeza que deseja excluir esta tarefa?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="btnConfirmarExclusao">Excluir</button>
      </div>
    </div>
  </div>
</div>

<script>
  let idTarefaParaExcluir = null;

  function abrirModalConfirmacao(id) {
    idTarefaParaExcluir = id;
    const modal = new bootstrap.Modal(document.getElementById('modalConfirmacao'));
    modal.show();
  }

  document.getElementById('btnConfirmarExclusao').addEventListener('click', () => {
    if (!idTarefaParaExcluir) return;

    fetch(`/tarefas/deletar/${idTarefaParaExcluir}`, {
      method: 'DELETE'
    })
      .then(res => res.json())
      .then(data => {
        const msgDiv = document.getElementById("mensagem-status");

        if (data.mensagem) {
          msgDiv.textContent = data.mensagem;
          msgDiv.className = "alert alert-success";
          msgDiv.style.display = "block";

          setTimeout(() => {
            msgDiv.style.display = "none";
            location.reload();
          }, 2000);
        } else {
          msgDiv.textContent = data.erro || "Erro ao excluir.";
          msgDiv.className = "alert alert-danger";
          msgDiv.style.display = "block";
        }

        const modalEl = document.getElementById('modalConfirmacao');
        bootstrap.Modal.getInstance(modalEl).hide();
        idTarefaParaExcluir = null;
      })
      .catch(() => {
        const msgDiv = document.getElementById("mensagem-status");
        msgDiv.textContent = "Erro ao excluir tarefa.";
        msgDiv.className = "alert alert-danger";
        msgDiv.style.display = "block";
      });
  });
</script>
